[Unit]
Description=Perfume Dispenser System
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
# Root is required for nmcli AP mode, iptables, and /etc/NetworkManager writes.
# GPIO and serial access work fine as root on Raspberry Pi OS.
User=root
WorkingDirectory=/home/pi/perfume-dispenser
ExecStart=/usr/bin/python3 -u /home/pi/perfume-dispenser/perfume_dispenser.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
# Force immediate output flushing
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
